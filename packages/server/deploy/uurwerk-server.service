[Unit]
Description=Uurwerk — main copy of the data, sync for the devices, published days for supervisor and teacher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uurwerk
Group=uurwerk
WorkingDirectory=/opt/uurwerk-server
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

# Everything the process needs to know. 8790, not 8787: Reisbouwer has that one.
# (MemoryDenyWriteExecute is left out on purpose: V8 JIT and WebAssembly need it.)
Environment=UURWERK_DATA_DIR=/var/lib/uurwerk
Environment=UURWERK_HOST=127.0.0.1
Environment=UURWERK_PORT=8790
Environment=UURWERK_TRUST_PROXY=1
Environment=UURWERK_SESSION_HOURS=12
Environment=UURWERK_TITLE=Uurwerk
# Jarvis: the model (see docs/jarvis.md). gemini-* needs geminiKey, gpt-* openaiKey, claude-* anthropicKey.
Environment=JARVIS_MODEL=gemini-3.8-flash
# Busy (503) or out of free quota (429): these next, in order.
Environment=JARVIS_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest
# How much it thinks per turn: low | medium | high. Medium is Luna's own default.
Environment=JARVIS_EFFORT=medium
Environment=AZURE_SPEECH_REGION=westeurope
# Optional: the old upload door. Put UURWERK_PUBLISH_TOKEN=… in
# /etc/uurwerk.env (root, 0640) only if something still PUTs to /publish/.
EnvironmentFile=-/etc/uurwerk.env

# The process reads its own data directory and nothing else on the machine.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/uurwerk
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

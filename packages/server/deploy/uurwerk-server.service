[Unit]
Description=Uurwerk — published internship days for the supervisor and the teacher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uurwerk
Group=uurwerk
WorkingDirectory=/opt/uurwerk-server
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

# Everything the process needs to know. The token must be the same one as
# Settings -> Publishing in the desktop app.
Environment=UURWERK_DATA_DIR=/var/lib/uurwerk
Environment=UURWERK_HOST=127.0.0.1
Environment=UURWERK_PORT=8787
Environment=UURWERK_TRUST_PROXY=1
Environment=UURWERK_SESSION_HOURS=12
Environment=UURWERK_TITLE=Uurwerk
# Keep the token out of this file and out of `systemctl cat`: put it in
# /etc/uurwerk.env as UURWERK_PUBLISH_TOKEN=…, owned by root, mode 0640.
EnvironmentFile=/etc/uurwerk.env

# The process reads its own data directory and nothing else on the machine.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/uurwerk
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
